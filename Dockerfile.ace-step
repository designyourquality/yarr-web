# YARR vocal GPU server - ACE-Step 1.5 (MIT) - RunPod Serverless (build from repo root)
# RunPod Dockerfile path: Dockerfile.ace-step . Our handler lives in gpu/ace-step/
# Same base image as the SA3 endpoint. ACE-Step runs in its own uv venv (CUDA 12.8 PyTorch) -> endpoint Minimum CUDA 12.8
# Note: the RunPod builder rejected our earlier Dockerfile before any step ran (no logs). This version avoids
# "curl | sh" and installs uv with pip instead.
FROM pytorch/pytorch:2.7.1-cuda12.6-cudnn9-runtime
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /app
RUN git clone https://github.com/ACE-Step/ACE-Step-1.5 /app && git checkout ca1e85fe9430179831e6bc6be790c332190a3866
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_LINK_MODE=copy
RUN uv python install 3.11 && uv sync --frozen --no-dev --python 3.11 && uv pip install --python /app/.venv/bin/python "runpod>=1.7" && rm -rf /root/.cache
# Vocal check (2026-11-02): faster-whisper base (CPU int8) in the image's own python (/opt/conda), NOT in the ACE venv,
# so ACE-Step packages stay exactly as before. The handler calls it as a subprocess; if anything is missing it is skipped.
RUN /opt/conda/bin/python -m pip install --no-cache-dir "faster-whisper==1.1.1" && /opt/conda/bin/python -c "from faster_whisper import WhisperModel; WhisperModel('base', device='cpu', compute_type='int8', download_root='/opt/whisper')"
# Stems (2026-11-04): Demucs htdemucs in /opt/conda too (separate from the ACE venv). The constraint keeps the image's torch
# version so pip never swaps torch; the model is downloaded at build time so the first request is fast.
RUN /opt/conda/bin/python -c "import torch; print('torch==' + torch.__version__.split('+')[0])" > /tmp/torch-pin.txt \
 && /opt/conda/bin/python -m pip install --no-cache-dir -c /tmp/torch-pin.txt "demucs==4.0.1" soundfile \
 && /opt/conda/bin/python -c "from demucs.pretrained import get_model; get_model('htdemucs')"
COPY gpu/ace-step/stems.py /app/yarr_stems.py
COPY gpu/ace-step/vocal_check.py /app/yarr_vocal_check.py
# Edit tools (2026-11-07): section timing (align.py · same whisper model) · mix/key/tempo uses ffmpeg in handler.py
COPY gpu/ace-step/align.py /app/yarr_align.py
COPY gpu/ace-step/handler.py /app/yarr_handler.py
COPY worker/guide.py /app/yarr_guide.py
ENV ACE_CKPT=/tmp/ace_ckpt HF_HOME=/tmp/hf PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
CMD ["/app/.venv/bin/python", "-u", "/app/yarr_handler.py"]
