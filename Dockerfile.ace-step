# YARR 보컬곡 GPU 서버 · ACE-Step 1.5 (MIT) · RunPod Serverless 용 (저장소 맨 위에서 빌드)
# RunPod 의 Dockerfile path 에 Dockerfile.ace-step 을 넣어요. 우리 코드는 gpu/ace-step 폴더에 있어요
# ACE-Step 은 CUDA 12.8 용 PyTorch 를 써요 → 엔드포인트의 Minimum CUDA version 을 12.8 로 두세요
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common build-essential git curl ffmpeg libsndfile1 \
    && add-apt-repository ppa:deadsnakes/ppa && apt-get update \
    && apt-get install -y --no-install-recommends python3.11 python3.11-dev python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.7 /uv /uvx /bin/

# 검증한 커밋으로 고정 (2026-08-29) · 바꿀 때는 시험 후에
ARG ACE_COMMIT=ca1e85fe9430179831e6bc6be790c332190a3866
WORKDIR /app
RUN git clone https://github.com/ACE-Step/ACE-Step-1.5 /app \
    && git checkout ${ACE_COMMIT} \
    && uv sync --frozen --no-dev --python python3.11 \
    && uv pip install --python /app/.venv/bin/python "runpod>=1.7" \
    && rm -rf /root/.cache

COPY gpu/ace-step/handler.py /app/yarr_handler.py
ENV ACE_CKPT=/tmp/ace_ckpt HF_HOME=/tmp/hf
CMD ["/app/.venv/bin/python", "-u", "/app/yarr_handler.py"]
