# YARR vocal GPU server - ACE-Step 1.5 (MIT) - RunPod Serverless (build from repo root)
# RunPod Dockerfile path: Dockerfile.ace-step . Our handler lives in gpu/ace-step/
# Base image is the same one that builds fine for the SA3 endpoint. ACE-Step runs in its own uv venv (CUDA 12.8 PyTorch),
# so set the endpoint Minimum CUDA version to 12.8. (ASCII only: the RunPod builder failed on some non-ASCII symbols)
FROM pytorch/pytorch:2.7.1-cuda12.6-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git curl ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*

# uv (package manager used by ACE-Step)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh && uv --version

# pinned to a tested commit (2026-08-29)
WORKDIR /app
RUN git clone https://github.com/ACE-Step/ACE-Step-1.5 /app && git checkout ca1e85fe9430179831e6bc6be790c332190a3866 && uv python install 3.11 && uv sync --frozen --no-dev --python 3.11 && uv pip install --python /app/.venv/bin/python "runpod>=1.7" && rm -rf /root/.cache

COPY gpu/ace-step/handler.py /app/yarr_handler.py
ENV ACE_CKPT=/tmp/ace_ckpt HF_HOME=/tmp/hf
CMD ["/app/.venv/bin/python", "-u", "/app/yarr_handler.py"]
